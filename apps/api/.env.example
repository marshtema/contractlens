# Database
DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=3001
NODE_ENV=development

# AI Provider: "mock" | "anthropic" | "openai"
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage: "local" (uploads/) | "r2" (Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# CORS
WEB_ORIGIN=http://localhost:3000
