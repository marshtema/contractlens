# Database
DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=3001
NODE_ENV=development

# AI Provider: "mock" | "groq" | "gemini" (anthropic/openai в будущем)
AI_PROVIDER=mock

# Groq (Llama 3.3 70B, бесплатно, ~30 req/min, доступен в РФ)
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (Google AI Studio) — бесплатный план, 1500 req/day, в РФ нужен VPN
# Получить ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Будущие провайдеры
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage: "local" (uploads/) | "r2" (Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# CORS
WEB_ORIGIN=http://localhost:3000
